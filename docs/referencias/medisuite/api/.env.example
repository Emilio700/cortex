# ---------- Obligatorias ----------
# Cadena de conexión a PostgreSQL 14+
DATABASE_URL=postgres://medisuite:cambia-esto@localhost:5432/medisuite
# 32 bytes aleatorios en base64 (cifra llaves de firma y secretos TOTP). Genera con: openssl rand -base64 32
# ¡No la pierdas! Sin ella no se pueden usar las llaves de firma guardadas.
MASTER_KEY=
# Opcional (privilegios mínimos): conexión del dueño del esquema para migraciones y purga de archivos.
# Si se define, DATABASE_URL debe usar el rol restringido de la app (ver APP_DB_ROLE y README).
# DATABASE_URL_MIGRATIONS=postgres://medisuite_owner:cambia-esto@localhost:5432/medisuite
# Rol de la app al que, tras migrar, se otorgan SELECT/INSERT/UPDATE (DELETE solo en sessions y
# preferencias; en audit_log solo SELECT/INSERT). Si el rol no existe, se omite.
# APP_DB_ROLE=medisuite_app

# ---------- Primer arranque (solo si no hay usuarios) ----------
ORG_NAME=Mi Clínica
ADMIN_EMAIL=admin@miclinica.mx
# Mínimo 10 caracteres; en producción se rechaza si es débil.
ADMIN_PASSWORD=

# ---------- Servidor ----------
NODE_ENV=production
PORT=3000
# Directorio de archivos subidos (volumen persistente)
FILES_DIR=./data/files
# true por defecto en producción (cookie solo por HTTPS)
COOKIE_SECURE=true
# true detrás de un proxy inverso (nginx) para registrar la IP real del cliente.
# También acepta un número de saltos o una lista de IPs/CIDR.
TRUST_PROXY=true
# Opcional: orígenes permitidos para CORS (separados por comas). Vacío = solo mismo origen.
CORS_ORIGIN=
# LOG_LEVEL=info
# RATE_LIMIT_GLOBAL=600   # solicitudes por minuto por IP
# RATE_LIMIT_LOGIN=10     # intentos de login por minuto por IP

# ---------- Demostración ----------
# Si es "true" y la base está vacía, carga datos sintéticos y usuarios demo
# (admin@demo.mx, medico@demo.mx, recepcion@demo.mx, enfermeria@demo.mx)
SEED_DEMO=false
DEMO_PASSWORD=MediSuite2026!

# Nota: una variable con valor vacío (X=) se trata como no definida (se usa el valor por defecto).

# ---------- URL pública (enlaces en correos) ----------
# Origen del frontend sin "/" final. Requerida para la recuperación de contraseña.
PUBLIC_URL=https://clinica.example.mx
# Zona horaria para fechas/horas de los recordatorios
# TZ_CLINICA=America/Mexico_City

# ---------- Correo (SMTP) ----------
# Usa SMTP_URL o bien SMTP_HOST/PORT/USER/PASS. Sin SMTP: no hay recuperación de contraseña por correo,
# ni recordatorios por correo, ni aviso de bloqueo de cuentas.
# SMTP_URL=smtps://usuario:clave@smtp.example.mx:465
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=false        # true para el puerto 465 (por defecto según el puerto)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MediSuite <no-responder@clinica.example.mx>
# RATE_LIMIT_RECUPERAR=5   # solicitudes de recuperación/restablecimiento por minuto por IP

# ---------- WhatsApp Cloud API (recordatorios) ----------
# Sin TOKEN + PHONE_NUMBER_ID + TEMPLATE: WhatsApp desactivado (503 whatsapp_no_configurado).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla aprobada (categoría "utility"): 4 variables en el cuerpo ({{1}} nombre, {{2}} fecha, {{3}} hora, {{4}} clínica)
# y 2 botones de respuesta rápida: [0] Confirmar, [1] Reagendar.
WHATSAPP_TEMPLATE=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es_MX
# Webhook (obligatorios en producción si WhatsApp está activo)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# Anticipación de los recordatorios en horas (lista)
RECORDATORIO_HORAS=24,2
# SCHEDULER=true            # false desactiva el programador en esta instancia
# SCHEDULER_INTERVAL_MS=60000

# ---------- Facturación CFDI 4.0 (Facturapi) ----------
# Llave secreta de la organización en Facturapi (sk_live_… o sk_test_…). Sin ella: 503 pac_no_configurado.
FACTURAPI_KEY=
# FACTURAPI_BASE=https://www.facturapi.io/v2

# ---------- Almacenamiento de archivos ----------
# disk (FILES_DIR, por defecto) o s3 (S3/MinIO/R2 compatible)
STORAGE=disk
# S3_ENDPOINT=https://minio.interno:9000   # vacío = AWS S3
# S3_BUCKET=medisuite-archivos
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true                 # por defecto true si hay S3_ENDPOINT

# ---------- Operación ----------
# Token Bearer para GET /api/metrics (Prometheus). Sin él, solo un admin con sesión.
METRICS_TOKEN=
