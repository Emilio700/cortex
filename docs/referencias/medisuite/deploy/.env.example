# MediSuite — variables de producción. Copia a deploy/.env y edítalo:  cp .env.example .env && chmod 600 .env
# NUNCA subas .env a git. Guarda una copia de MASTER_KEY y POSTGRES_PASSWORD en tu gestor de contraseñas.

# ---------- Dominio y certificados ----------
# El registro DNS A/AAAA del dominio debe apuntar a la IP del servidor ANTES de arrancar.
DOMINIO=expediente.miclinica.mx
ACME_EMAIL=sistemas@miclinica.mx

# ---------- Base de datos ----------
# Dos roles (privilegios mínimos):
#   POSTGRES_USER  dueño del esquema: migraciones, respaldos, purga de archivos. La API solo lo usa al migrar.
#   APP_DB_ROLE    rol de la aplicación (LOGIN, sin superusuario, sin DDL, sin UPDATE/DELETE en la bitácora).
#                  Lo crea db/initdb/10-medisuite-roles.sh y lo sincroniza el servicio db-init en cada "up".
POSTGRES_USER=medisuite
POSTGRES_DB=medisuite
# Genera con: openssl rand -base64 24 | tr -d '/+='   (sin / + = porque va dentro de una URL)
POSTGRES_PASSWORD=CAMBIA-ESTO
APP_DB_ROLE=medisuite_app
# Genera con: openssl rand -hex 24   (distinta de POSTGRES_PASSWORD)
APP_DB_PASSWORD=CAMBIA-ESTO-TAMBIEN

# ---------- API ----------
# Llave maestra de cifrado (32 bytes en base64). Genera con: openssl rand -base64 32
# Sin ella no se pueden descifrar los secretos guardados (2FA, llaves de firma). Respáldala aparte.
MASTER_KEY=CAMBIA-ESTO
# Administrador inicial (se crea solo si la base está vacía). Cambia la contraseña al entrar y activa 2FA.
ADMIN_EMAIL=admin@miclinica.mx
ADMIN_PASSWORD=CAMBIA-ESTO-min-12-caracteres
ORG_NAME=Consultorio Médico Ejemplo
# Datos de demostración (pacientes sintéticos). En producción con pacientes reales: false.
SEED_DEMO=false
DEMO_PASSWORD=
# Saltos de proxy de confianza para la IP real del cliente (Caddy → api = 1).
TRUST_PROXY=1
TZ=America/Mexico_City

# ---------- API: integraciones opcionales ----------
# Descomenta solo las que uses. Una variable vacía ("X=") equivale a no definirla (la API usa su valor por defecto).
# PUBLIC_URL se calcula sola (https://DOMINIO) y TZ_CLINICA = TZ. Detalle de cada una: api/README.md.
#
# Correo (recuperación de contraseña, recordatorios por correo, aviso de cuentas bloqueadas):
# Usa SMTP_URL o bien SMTP_HOST/PORT/USER/PASS:
# SMTP_URL=smtps://usuario:clave@smtp.miproveedor.com:465
# SMTP_HOST=smtp.miproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=MediSuite <no-responder@miclinica.mx>
#
# WhatsApp Cloud API (recordatorios automáticos; Meta será encargado: menciónalo en tu aviso de privacidad).
# Webhook en Meta: https://DOMINIO/api/webhooks/whatsapp (Caddy lo reenvía sin tocar el cuerpo; se verifica la firma).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=recordatorio_cita
# WHATSAPP_TEMPLATE_LANG=es_MX
# Obligatorias con WhatsApp: token de verificación (openssl rand -hex 16) y App Secret de Meta (firma HMAC del webhook)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# RECORDATORIO_HORAS=24,2
# SCHEDULER=true
# SCHEDULER_INTERVAL_MS=60000
#
# Timbrado CFDI 4.0 con Facturapi (PAC):
# FACTURAPI_KEY=sk_live_...
# FACTURAPI_BASE=https://www.facturapi.io/v2
#
# Archivos en S3 en lugar del volumen local (¡entonces el servicio backup NO los respalda: usa versionado y
# cifrado del bucket!):
# STORAGE=s3
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
#
# Métricas Prometheus: /api/metrics está BLOQUEADO en Caddy (no sale a Internet). Prometheus debe leerlo por
# la red interna (http://api:3000/api/metrics) con "Authorization: Bearer $METRICS_TOKEN".
# Genera con: openssl rand -hex 32
# METRICS_TOKEN=
#
# Otros: LOG_LEVEL=info · CORS_ORIGIN= (vacío = solo mismo origen) · RATE_LIMIT_GLOBAL=600 · RATE_LIMIT_LOGIN=10 ·
# RATE_LIMIT_RECUPERAR=5

# ---------- Versiones de imagen ----------
# Etiqueta de las imágenes construidas (p. ej. la fecha o el tag de git: 2026.10.1). Útil para rollback.
VERSION=latest
REGISTRO=medisuite

# ---------- CSP (encabezados del frontend) ----------
# Orígenes extra para fetch (servicios en OTRO dominio; los del perfil "servicios" ya son del mismo origen).
CSP_CONNECT_EXTRA=
# Orígenes extra para iframes (p. ej. tu Jitsi propio: https://meet.miclinica.mx)
CSP_FRAME_EXTRA=
# Origen de Jitsi para Permissions-Policy (cámara/micrófono en el iframe)
PP_JITSI=https://meet.jit.si
# Vacío = se calcula solo (onnxruntime-web en jsDelivr, para Whisper en el navegador). "off" lo desactiva.
CSP_ORT_SRC=

# ---------- Respaldos ----------
BACKUP_TIME=03:15
BACKUP_RETENTION_DAYS=14
# Carpeta del servidor donde quedan los respaldos locales
BACKUP_HOST_DIR=./respaldos
# Cifrado (recomendado): llave(s) PÚBLICA(S) age separadas por espacio. Crea el par en TU computadora:
#   age-keygen -o medisuite-respaldos.key   (guarda la llave privada fuera del servidor)
BACKUP_AGE_RECIPIENTS=
# Copia fuera del servidor (S3 compatible: AWS S3, Backblaze B2, DigitalOcean Spaces, Wasabi, Cloudflare R2...)
# Formato: s3:<bucket>/<carpeta>. Vacío = solo local.
BACKUP_RCLONE_REMOTE=
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ON_START=false

# ---------- Perfil opcional "servicios" (Orthanc, OHIF, Whisper, Presidio) ----------
# Usuario/contraseña para /orthanc, /whisper, /presidio-*. Hash con:
#   docker run --rm caddy:2.11-alpine caddy hash-password --plaintext 'tu-contraseña'
# Ponlo ENTRE COMILLAS SIMPLES (contiene $).
SERVICIOS_USUARIO=servicios
SERVICIOS_HASH=
# Subdominio de OHIF (requiere renombrar caddy/extra/ohif.caddy.example a ohif.caddy)
OHIF_DOMINIO=
# Interfaz donde escucha el puerto DICOM 4242 (127.0.0.1 = solo local; IP privada/VPN para equipos de imagen)
ORTHANC_DICOM_BIND=127.0.0.1
