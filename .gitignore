# Root-level ignores. backend/ and frontend/ have their own .gitignore
# for language-specific artifacts (venv, node_modules, etc.) - this one
# covers things that live at the repo root, primarily real env files used
# by the top-level docker-compose*.yml files.
.env
.env.prod
.env.production
.env.local
.env.*.local

# Python cache files can also be generated by root-level maintenance scripts.
__pycache__/
*.py[cod]
.deploy/
backups/

# Datos de ejecución: los estudios de imagen se guardan bajo tenants/<id>/patients/...
/backend/tenants/
# Estudio de demostración que genera scripts/generar_estudio_demo.py
/backend/estudio_demo.zip

# Propuesta MediSuite de Agustín: trae su propio .git y un zip. Es material de
# referencia; lo que se adopte se copia, se adapta y conserva su nota de origen.
Agustin-Propuesta/

# Atlas detallado de Neuro 3D (BodyParts3D): lo genera cada servidor con
# scripts/atlas/preparar_atlas.py; los modelos no se guardan en git.
/frontend/public/atlas/
