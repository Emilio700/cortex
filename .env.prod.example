# Copy to .env.prod (or wherever `docker compose --env-file` points) and
# fill in real values before running docker-compose.prod.yml. Variables
# without a `:?` fallback in the compose file are optional.

# --- Database ---
POSTGRES_USER=cortex_user
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=cortex_db

# --- Backend ---
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-secret
# Comma-separated list of exact origins allowed to call the API (the
# frontend's real public URL) - do NOT use a wildcard in production.
CORS_ORIGINS=https://app.example.com
# Public URL of the frontend. Used to build the password-reset link inside
# emails - if this is wrong users receive a link that only works on the server.
FRONTEND_URL=https://app.example.com
ACCESS_TOKEN_EXPIRE_MINUTES=30
# MFA desactivado por defecto. Para reactivarlo: MFA_REQUIRED_ROLES=master,admin,doctor
MFA_REQUIRED_ROLES=
MFA_ISSUER=G.E.M.S

# Numero maximo de sucursales (tenants) que se pueden dar de alta.
# Subir el tope es cambiar este valor y reiniciar el backend.
MAX_TENANTS=5

# Upload security. Keep REQUIRED=true in production; uploads fail closed if
# the antivirus service cannot verify them.
ANTIVIRUS_ENABLED=true
ANTIVIRUS_REQUIRED=true

# "local" is valid for one instance with the named volume. Use "s3" before
# scaling backend replicas and fill the private S3-compatible credentials.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (Fase 4.2) - leave EMAIL_ENABLED=false to keep sends logged only
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@cortex.local
EMAIL_FROM_NAME=G.E.M.S

# --- Frontend ---
# The public URL the BROWSER uses to reach the backend - baked into the
# JS bundle at build time, changing it requires rebuilding the frontend image.
VITE_API_BASE_URL=/
FRONTEND_PORT=80

# --- Misc ---
# Tag used for both images (cortex-backend:$IMAGE_TAG, cortex-frontend:$IMAGE_TAG)
IMAGE_TAG=latest

# --- Servicios auxiliares de los módulos extra (todos opcionales) ---
# Vacío = no instalado: el módulo que lo necesita no se deja encender.
# Orthanc (perfil «imagen» de docker-compose): recepción de estudios desde equipos.
ORTHANC_URL=
ORTHANC_USUARIO=
ORTHANC_PASSWORD=
# Whisper/speaches (perfil «ia»): dictado.
WHISPER_URL=
# Presidio analyzer (perfil «ia»): desidentificación antes de enviar a la IA.
PRESIDIO_URL=
# Segmentador (perfil «ia»): modelo 3D del paciente desde su TC, para Neuro 3D.
# Dentro de Docker: http://segmentador:8000 · fuera: http://localhost:8030
SEGMENTADOR_URL=
# Cuánto se espera una segmentación antes de darla por fallida (CPU: minutos).
SEGMENTADOR_TIEMPO_LIMITE_SEGUNDOS=1800
# Asistente IA: ninguno | ollama | deepseek | anthropic. Con un proveedor remoto,
# IA_API_KEY es obligatoria en producción. Nunca pongas la llave en un archivo versionado.
IA_PROVEEDOR=ninguno
IA_MODELO=
IA_BASE_URL=
IA_API_KEY=
