# Database Configuration
DATABASE_URL=postgresql://gems_user:gems_password@localhost:5432/gems_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URL pública del frontend — usada para armar el enlace de restablecer
# contraseña que va dentro del correo. En producción debe ser el dominio real.
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development

# Email / SMTP — el App Password de Gmail va aquí (archivo NO versionado),
# nunca en docker-compose.yml.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@gems.local
EMAIL_FROM_NAME=G.E.M.S

# Número máximo de sucursales (tenants) que se pueden dar de alta.
MAX_TENANTS=5

# Application
APP_NAME=G.E.M.S
API_V1_PREFIX=/api/v1
